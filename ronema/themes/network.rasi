configuration {
    show-icons: true;
    icon-theme: "Papirus";
    font: "JetBrainsMono Nerd Font 13";
    display-dmenu: "Network:";
}

@theme "/dev/null"

* {
    bg-col:      #1f2030ed;
    bg-alt:      #222436;
    border-col:  #43bee0;
    text-col:    #c7c5c7;
    prompt-col:  #d3717e;
    select-col:  #43bee066;
    select-txt:  #d3717e;

    background-color: transparent;
    text-color:       @text-col;
}

window {
    width:            450px;
    anchor:           center;
    location:         center;
    x-offset:         0;
    y-offset:         0;

    background-color: @bg-col;
    border:           2px;
    border-color:     @border-col;
}

mainbox {
    padding:          20px;
    children:         [ inputbar, listview ];
}

/* Search / Prompt Bar */
inputbar {
    background-color: @bg-alt;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
    margin:           0px 0px 14px 0px;
}

prompt {
    text-color:       @prompt-col;
}

entry {
    placeholder:      "";
}

/* Single Column Layout (5 lines) */
listview {
    columns:          1;
    lines:            5;
    cycle:            false;
    dynamic:          true;
    scrollbar:        false;
    spacing:          6px;
    fixed-height:     true;
}

/* Horizontal List Element */
element {
    orientation:      horizontal;
    padding:          8px 12px;
}

element-icon {
    size:             24px;
    cursor:           pointer;
}

element-text {
    font:             "JetBrainsMono Nerd Font 12";
    cursor:           pointer;
    vertical-align:   0.5;
    margin:           0px 0px 0px 10px;
}

/* Highlight Colors */
element selected {
    background-color: @select-col;
}

element-text selected {
    text-color:       @select-txt;
}
